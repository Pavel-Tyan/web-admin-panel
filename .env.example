# Скопируйте в .env.local и при необходимости поменяйте значения (.env.local не коммитится).

# Куда dev-сервер Vite проксирует запросы /api (API Gateway).
# Стенд из коллекции Postman; для локального бэкенда — http://localhost:8080
API_PROXY_TARGET=https://mpi.notme.work.gd

# Базовый путь API для axios-клиента
VITE_API_BASE_URL=/api
